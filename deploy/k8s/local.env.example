# deploy/k8s 的本地部署值。清单里凡是跟环境有关的地方都写成 @@占位符@@，
# render.sh 读这个文件替换掉占位符，把可直接 apply 的清单输出到 rendered/。
#
#   cd deploy/k8s
#   cp local.env.example local.env    # 第一次：按自己的环境填
#   $EDITOR local.env
#   ./render.sh                       # 结果在 rendered/
#   kubectl apply -f rendered/
#
# local.env 与 rendered/ 都在 .gitignore 里，真实值不会进仓库。
# 每一项的含义见下面注释，整体说明见 DEPLOY.md 的「本地化配置」一节。

# 镜像仓库，不带结尾斜杠（可以带端口）。清单里写成 @@IMAGE_REGISTRY@@/pp1/<服务>:<tag>。
# 必须是 kubelet 能直接拉的完整地址：短名会被 kubelet 当成 docker.io 下的仓库。
# 例：docker.io/<你的账号>、registry.example.com:5000、harbor.example.internal
IMAGE_REGISTRY=registry.example.com:5000

# PVC 的 storageClassName，要支持 ReadWriteMany（asr / tts / chat 共用同一份模型）。
STORAGE_CLASS=nfs-client

# ingress 的基础域名。三个访问地址是 pp1.<域名>、pp1-asr.<域名>、pp1-tts.<域名>，
# 证书签 *.<域名>，所以 cert-manager 要能对这个域名做 DNS-01 校验。
INGRESS_DOMAIN=example.com

# 上一项那张证书用的 cert-manager ClusterIssuer 名字。
CLUSTER_ISSUER=letsencrypt-dns01

# 本机暂存大模型的目录：权重下载脚本的默认 DEST，只在重下权重时用到。
WEIGHTS_DIR=/data/weights
