# pp1 在 zmlp 开发机里的运行配置（被 pp1-up.sh / pp1-down.sh / pp1-status.sh source）。
# 只放"怎么跑"，不放密钥：brain token 只在 PP1_BRAIN_TOKEN_FILE 指向的文件里。
#
# 镜像来源：另一个流程会把 k8s 里那四个镜像推到 harbor 的 library 项目下。
# 如果实际 tag 不同，改这里即可，脚本不关心。
PP1_REGISTRY="${PP1_REGISTRY:-<registry>/library}"
PP1_ASR_IMAGE="${PP1_ASR_IMAGE:-$PP1_REGISTRY/pp1-asr:0.1.2}"
PP1_TTS_IMAGE="${PP1_TTS_IMAGE:-$PP1_REGISTRY/pp1-tts:0.1.0}"
PP1_CHAT_IMAGE="${PP1_CHAT_IMAGE:-$PP1_REGISTRY/pp1-chat-vllm:v0.32.0}"
PP1_BRAIN_IMAGE="${PP1_BRAIN_IMAGE:-$PP1_REGISTRY/pp1-brain:0.1.0}"

# 开发机里挂载的 CephFS 项目卷前缀（machine.yaml 的 subpath=pp1）对应容器内 /models。
#   /models/asr/Qwen3-ASR-1.7B
#   /models/tts/*.gguf
#   /models/chat/Qwen2.5-Omni-7B
#   /models/voices/male-fun.wav
#   /models/pp1/{logs,run,secrets}     运行时数据
PP1_WEIGHTS="${PP1_WEIGHTS:-/models}"
PP1_DATA="${PP1_DATA:-/models/pp1}"
PP1_LOG_DIR="$PP1_DATA/logs"
PP1_RUN_DIR="$PP1_DATA/run"
PP1_SECRET_DIR="$PP1_DATA/secrets"
PP1_BRAIN_TOKEN_FILE="${PP1_BRAIN_TOKEN_FILE:-$PP1_SECRET_DIR/brain-token}"
PP1_REQUIRE_BRAIN_TOKEN="${PP1_REQUIRE_BRAIN_TOKEN:-1}"

# auto = 先 docker 后 nerdctl；也可写死 docker / nerdctl。
# 开发机里如果要用 sudo，把 PP1_RUNTIME_SUDO 设成 sudo（脚本会拼成 "sudo nerdctl"）。
PP1_RUNTIME="${PP1_RUNTIME:-auto}"
PP1_RUNTIME_SUDO="${PP1_RUNTIME_SUDO:-}"

# host = 容器直接共享开发机网络命名空间，四个端口就地暴露，brain 用 127.0.0.1 访问；
# bridge = 走端口映射，需要把下面的 PP1_HOST_ALIAS 改成 host.docker.internal。
PP1_NETWORK="${PP1_NETWORK:-host}"
PP1_HOST_ALIAS="${PP1_HOST_ALIAS:-127.0.0.1}"

# 端口与 k8s 清单保持一致，手机 / 桥 / brain 都不用改端口。
PP1_ASR_PORT="${PP1_ASR_PORT:-8082}"
PP1_TTS_PORT="${PP1_TTS_PORT:-8080}"
PP1_CHAT_PORT="${PP1_CHAT_PORT:-8000}"
PP1_BRAIN_PORT="${PP1_BRAIN_PORT:-8787}"

# 整卡分配：GPU0 给 asr + tts（5 + 13.7 GB），GPU1 独占给 chat。
PP1_ASR_TTS_GPU="${PP1_ASR_TTS_GPU:-0}"
PP1_CHAT_GPU="${PP1_CHAT_GPU:-1}"

# tts 镜像里的进程以 1000 运行（对应 compose 的 MOSS_UID），而 host 网络 + bind mount
# 下容器内 uid 就是宿主 uid。如果日志报 permission denied，把它设成 1000:1000，
# 并 chown -R 1000:1000 那个卷上的 voices / pp1 目录。
PP1_TTS_USER="${PP1_TTS_USER:-}"

# 启动等待上限（秒）。asr 完成预热才监听；tts 要加载两个常驻 daemon；chat 要加载 22GB 权重。
PP1_ASR_TIMEOUT="${PP1_ASR_TIMEOUT:-600}"
PP1_TTS_TIMEOUT="${PP1_TTS_TIMEOUT:-900}"
PP1_CHAT_TIMEOUT="${PP1_CHAT_TIMEOUT:-1200}"
PP1_BRAIN_TIMEOUT="${PP1_BRAIN_TIMEOUT:-60}"

# ── ASR（docker/asr/server.py）──
ASR_MODEL="/models/Qwen3-ASR-1.7B"

# ── TTS（moss-tts-windowed entrypoint.sh），与 k8s 02-config.yaml 逐项一致 ──
MOSS_MODELS_DIR="/models"
MOSS_VOICES_DIR="/voices"
MOSS_DAEMON_SOCK="/run/moss/serve.sock"
MOSS_LOG_DIR="/var/log/moss"
MOSS_LISTEN_PORT="8080"
MOSS_NGL="-1"
MOSS_MODEL_FILE="moss_tts_v15_firstclass_q4_k_m_aq8.gguf"
MOSS_DECODER_FILE="moss_tts_audio_decoder_f16.gguf"
MOSS_DAEMONS="${MOSS_DAEMONS:-2}"
MOSS_LANGUAGE="zh"
MOSS_AUDIO_TEMPERATURE="1.7"
MOSS_AUDIO_TOP_P="0.8"
MOSS_AUDIO_TOP_K="25"
MOSS_AUDIO_REPETITION_PENALTY="1.0"
MOSS_STREAM_WINDOW="32"
MOSS_STREAM_OVERLAP="40"
MOSS_STREAM_LOOKAHEAD="0"
MOSS_CTX_ROWS="6000"
MOSS_CTX_KEEP="2048"
MOSS_PREFILL_UBATCH="384"
MOSS_PREFILL_BUDGET_MIB="1000"
MOSS_MAX_INPUT_CHARS="2048"
MOSS_QUEUE_MAX="8"
MOSS_QUEUE_WAIT="60"
MOSS_LOG_TEXT="0"
MOSS_DISABLE_NONSTREAM="1"

# ── chat：vLLM + Qwen2.5-Omni-7B（参数抄 k8s 08-chat.yaml）──
# --gpu-memory-utilization 从 k8s 的 0.55 提到 0.90：开发机里这张卡归 chat 独占，
# 不再需要给 asr/tts 留同卡邻居的余量。
PP1_CHAT_ARGS=(
  "/models/Qwen2.5-Omni-7B"
  "--served-model-name=qwen2.5-omni-7b"
  "--host=0.0.0.0"
  "--port=$PP1_CHAT_PORT"
  "--chat-template=/templates/qwen-omni-tools.jinja"
  "--enable-auto-tool-choice"
  "--tool-parser-plugin=/templates/omni_bare_json_tool_parser.py"
  "--tool-call-parser=omni_bare_json"
  "--gpu-memory-utilization=0.90"
  "--max-model-len=32768"
  "--limit-mm-per-prompt={\"audio\":8,\"image\":1,\"video\":1}"
)

# ── brain：指向本机（host 网络）的另外三个服务 ──
# 如果 brain 仍留在 k8s 里，把下面三个地址改成开发机的可达地址（集群内 IP 或端口映射域名），
# 并在 k8s 侧配置同样的 bearer token。
STT_API_BASE_URL="${STT_API_BASE_URL:-http://$PP1_HOST_ALIAS:$PP1_ASR_PORT/v1}"
STT_API_KEY="${STT_API_KEY:-}"
STT_MODEL="${STT_MODEL:-qwen-asr}"
TTS_API_BASE_URL="${TTS_API_BASE_URL:-http://$PP1_HOST_ALIAS:$PP1_TTS_PORT/v1}"
TTS_API_KEY="${TTS_API_KEY:-}"
TTS_VOICE="${TTS_VOICE:-male-fun}"
MIGHT_BRAINS_PORT="$PP1_BRAIN_PORT"
MIGHT_BRAINS_POLL_TIMEOUT_MS="${MIGHT_BRAINS_POLL_TIMEOUT_MS:-25000}"
MIGHT_LOG_LLM="${MIGHT_LOG_LLM:-0}"
MIGHT_CHAT_API_BASE_URL="${MIGHT_CHAT_API_BASE_URL:-http://$PP1_HOST_ALIAS:$PP1_CHAT_PORT/v1}"
MIGHT_CHAT_API_KEY="${MIGHT_CHAT_API_KEY:-pp1-local}"
MIGHT_CHAT_MODEL="${MIGHT_CHAT_MODEL:-qwen2.5-omni-7b}"
